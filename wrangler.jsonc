{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appm",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "94c3de11-e642-4a37-8b5a-19fe72e6cfda","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a17ca5210c6140db8691c269e2f16c00" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
